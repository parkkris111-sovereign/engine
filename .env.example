# Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/municipal_audit

# Connection Pool Configuration
# Maximum number of concurrent database connections
# Default: 50 (recommended for high-concurrency audit systems)
# For single-instance deployment: 20-50
# For multi-instance: 10-20 per instance
DB_MAX_CONNECTIONS=50

# Logging Configuration
# Set verbosity level: error, warn, info, debug, trace
# Default: info
# Use debug for development, info for production
RUST_LOG=info
